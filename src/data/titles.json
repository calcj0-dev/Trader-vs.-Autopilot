{
  "nearBottom": { "windowMonths": 24, "ratio": 1.03 },
  "rules": [
    { "id": "cash_lover", "when": { "trades": { "max": 0 } } },
    { "id": "one_button", "when": { "trades": { "min": 1, "max": 1 } } },
    { "id": "from_future", "when": { "outcome": ["historic"] } },
    { "id": "quit_job", "when": { "outcome": ["rout"] } },
    { "id": "beats_tsumitate", "when": { "outcome": ["win"], "sells": { "max": 9 } } },
    { "id": "tired_fingers", "when": { "outcome": ["win"] } },
    { "id": "practically_tsumitate", "when": { "outcome": ["draw"] } },
    { "id": "practically_tsumitate", "when": { "outcome": ["lose"], "diffAbove": -0.01 } },
    { "id": "bottom_sommelier", "when": { "outcome": ["lose"], "nearBottom": true } },
    { "id": "chart_talker", "when": { "outcome": ["lose"], "sells": { "min": 10 } } },
